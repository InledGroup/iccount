{
  "name": "iccount",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "node scripts/e2e-check.mjs",
    "gen:keys": "node scripts/gen-keys.mjs",
    "db:init": "wrangler d1 execute iccount --local --file=schema.sql",
    "db:seed": "wrangler d1 execute iccount --local --file=seeds.sql",
    "db:init:remote": "wrangler d1 execute iccount --remote --file=schema.sql",
    "db:seed:remote": "wrangler d1 execute iccount --remote --file=seeds.sql",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12",
    "hono": "^4.13.19",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
