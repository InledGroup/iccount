---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { readSession } from '../server/session';
import { localeFromRequest, t } from '../i18n';

const locale = localeFromRequest(Astro.request);
const session = await readSession(env as unknown as Env, Astro.request);

if (session) {
  return Astro.redirect('/account');
}
const next = Astro.url.searchParams.get('next') ?? '/';
const registerHref = next && next !== '/'
  ? `/register?next=${encodeURIComponent(next)}`
  : '/register';
---

<Base title={t(locale, 'login.title')}>
  <div class="narrow">
    <div class="auth-head">
      <h1 class="auth-title">{t(locale, 'login.title')}</h1>
    </div>

    <div class="card">
      <form id="login-form" novalidate>
        <div class="field">
          <label for="email">{t(locale, 'login.email')}</label>
          <input id="email" name="email" type="email" autocomplete="username" required maxlength="254" />
        </div>

        <div class="field">
          <label for="password">{t(locale, 'login.password')}</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </div>

        <input type="hidden" name="next" value={next} />

        <p class="alert error" id="form-error" role="alert" hidden></p>
        <p class="muted" id="status" style="text-align: center;" hidden>{t(locale, 'login.status')}</p>

        <button type="submit" id="submit" style="width: 100%;">{t(locale, 'login.submit')}</button>
        <p class="auth-switch">
          {t(locale, 'login.noAccount')} <a href={registerHref}>{t(locale, 'login.create')}</a>
        </p>
      </form>
    </div>
  </div>
</Base>

<script>
  import '../scripts/login';
</script>
