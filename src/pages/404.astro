---
import Base from '../layouts/Base.astro';
import { localeFromRequest, t } from '../i18n';

const locale = localeFromRequest(Astro.request);
---

<Base title={t(locale, 'notfound.title')}>
  <div class="narrow card" style="text-align: center;">
    <h1 style="font-size: 2.5rem;">404</h1>
    <p class="lede" style="margin: 0.75rem 0 1.5rem;">{t(locale, 'notfound.title')}</p>
    <a class="btn" href="/">{t(locale, 'notfound.back')}</a>
  </div>
</Base>
